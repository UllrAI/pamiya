{
  "name": "@pamiya/dsh-plugin",
  "version": "0.2.0",
  "description": "Pamiya remote workers and guided setup for DeepSeek Harness",
  "type": "module",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.19.0",
    "dsh": "0.2.0-rc.2 || 0.2.1-alpha.4"
  },
  "exports": {
    ".": "./dist/host.js",
    "./client": "./dist/client.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "pamiya-worker": "./dist/worker.js"
  },
  "files": [
    "dist",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  },
  "scripts": {
    "build": "node build.mjs",
    "test": "node build.mjs && node --test tests/*.test.mjs",
    "check": "node --check src/host.js && node --check src/controller.js && node --check src/worker.js && npm run format:check",
    "format:check": "prettier --check src tests build.mjs"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "mqtt": "5.16.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "aedes": "^1.2.0",
    "esbuild": "0.28.2",
    "js-yaml": "^5.4.3",
    "prettier": "^3.8.3",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/UllrAI/pamiya.git",
    "directory": "packages/dsh-plugin"
  },
  "homepage": "https://github.com/UllrAI/pamiya/blob/main/docs/en/quickstart.md",
  "bugs": {
    "url": "https://github.com/UllrAI/pamiya/issues"
  }
}
